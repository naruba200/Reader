{
  "name": "smart-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Smart Reader & Language Learning Tool - MVP (Phase Alpha Web SPA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
